{
  "name": "@antelopejs/mysql",
  "version": "0.1.2",
  "description": "MySQL and MariaDB backend for AntelopeJS, implementing the Database interface on relational tables, with an external mode for existing databases.",
  "keywords": [
    "antelopejs",
    "database",
    "existing-database",
    "mariadb",
    "mysql",
    "mysql2",
    "sql"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/database",
  "bugs": {
    "url": "https://github.com/AntelopeJS/mysql/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/mysql.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "lint": "oxlint && antelopejs-check-interface-ranges",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm run build",
    "release": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "for image in ${MYSQL_TEST_IMAGES:-mysql:8.4 mysql:9.7 mariadb:11.8 mariadb:12.3}; do docker pull -q $image >/dev/null 2>&1 & done; pnpm run build && scripts/test.sh",
    "test:external": "pnpm run build && pnpm run test:external:run",
    "test:external:run": "MYSQL_TEST_MODE=external ajs module test . $(for file in dist/test-external/*.test.js; do printf -- '-f %s ' \"$file\"; done)",
    "test:decorators": "pnpm run build && scripts/decorators.sh",
    "test:unit": "pnpm run build && mocha \"dist/test/unit/**/*.spec.js\"",
    "bench": "pnpm run build && rimraf bench/dist && tsc -p bench/tsconfig.json && node bench/dist/orchestrate.js",
    "typecheck": "tsc --noEmit",
    "prepare": "if [ -e .git ] && command -v git >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1 && GIT_DIR=.git GIT_WORK_TREE=. git rev-parse --git-dir >/dev/null 2>&1; then GIT_DIR=.git GIT_WORK_TREE=. lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "suppressions": "antelopejs-suppressions",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "suppressions:update": "antelopejs-suppressions --update",
    "sync:check": "antelopejs-sync --check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.1.1 <1.0.0",
    "@antelopejs/interface-database": ">=0.4.0 <0.5.0",
    "@antelopejs/interface-database-catalog": ">=0.0.3 <0.1.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@antelopejs/api": "^1.7.3",
    "@antelopejs/core": "^1.21.0",
    "@antelopejs/interface-api": "^0.3.2",
    "@antelopejs/interface-database-decorators": "^0.5.2",
    "@antelopejs/postgres": "0.4.0",
    "@antelopejs/tooling-configs": "^0.5.6",
    "@testcontainers/mysql": "^12.2.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "chai": "^4.5.0",
    "fast-check": "^4.10.2",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mocha": "^11.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-database",
      "@antelopejs/interface-database-catalog"
    ],
    "defaultConfig": {
      "url": "mysql://root@localhost:3306/antelopejs",
      "migrations": "safe"
    },
    "test": "src/test/antelope.test.ts",
    "docs": {
      "standard": true
    }
  }
}
