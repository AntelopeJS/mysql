{
  "name": "@antelopejs/mysql",
  "version": "0.2.9",
  "description": "MySQL and MariaDB backend for AntelopeJS, implementing the Database interface on relational tables, with an external mode for existing databases.",
  "keywords": [
    "antelopejs",
    "database",
    "existing-database",
    "mariadb",
    "mysql",
    "mysql2",
    "sql"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/database",
  "bugs": {
    "url": "https://github.com/AntelopeJS/mysql/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/mysql.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm run build",
    "release": "pnpm run typecheck && pnpm run lint && pnpm run prepack && release-it",
    "test": "scripts/test.sh --build",
    "test:external": "pnpm run build && pnpm run test:external:run",
    "test:external:run": "MYSQL_TEST_MODE=external ajs module test --timeout 30000 . $(for file in dist/test-external/*.test.js; do printf -- '-f %s ' \"$file\"; done)",
    "test:decorators": "pnpm run build && scripts/decorators.sh",
    "test:unit": "pnpm run build && mocha \"dist/test/unit/**/*.spec.js\" --timeout 30000",
    "test:bench": "rimraf bench/dist && tsc -p bench/tsconfig.json && mocha \"bench/dist/**/*.spec.js\" --timeout 30000",
    "bench": "pnpm run build && rimraf bench/dist && tsc -p bench/tsconfig.json && node bench/dist/orchestrate.js",
    "typecheck": "tsc --noEmit",
    "prepare": "if [ -e .git ] && command -v git >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1 && GIT_DIR=.git GIT_WORK_TREE=. git rev-parse --git-dir >/dev/null 2>&1; then GIT_DIR=.git GIT_WORK_TREE=. lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "suppressions": "antelopejs-suppressions",
    "sync": "antelopejs-sync",
    "suppressions:update": "antelopejs-suppressions --update",
    "sync:check": "antelopejs-sync --check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.5.1 <0.6.0",
    "@antelopejs/interface-database": ">=0.4.4 <0.5.0",
    "@antelopejs/interface-database-catalog": ">=0.1.1 <0.2.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@antelopejs/api": "~1.7.4",
    "@antelopejs/core": "~1.24.0",
    "@antelopejs/interface-api": ">=0.3.3 <0.4.0",
    "@antelopejs/interface-database-decorators": ">=0.5.2 <0.6.0",
    "@antelopejs/postgres": ">=0.4.2 <0.5.0",
    "@antelopejs/tooling-configs": "^0.10.14",
    "@testcontainers/mysql": "^12.2.1",
    "@types/chai": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.0.0",
    "fast-check": "^4.10.2",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mocha": "^12.0.0",
    "oxfmt": "^0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^21.0.0",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.9",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-database",
      "@antelopejs/interface-database-catalog"
    ],
    "defaultConfig": {
      "url": "mysql://root@localhost:3306/antelopejs",
      "migrations": "safe"
    },
    "test": "src/test/antelope.test.ts",
    "docs": {
      "standard": true
    }
  }
}
